# Optional. The room works without this file: it plays councils you run in Claude Code.
#
# API mode calls a local messages endpoint only. Copy this file to .env, set the
# key, set COUNCIL_RUNNER=api, and uncomment ANTHROPIC_BASE_URL.
# Only loopback is accepted: localhost, 127.0.0.1, or ::1.
# https://api.anthropic.com and any other public host are refused. There is no public fallback.
# Viewer (the default) does not call the messages API.

# Sent only to ANTHROPIC_BASE_URL. Never sent to a public host.
ANTHROPIC_API_KEY=
# "viewer" (default) or "api"
COUNCIL_RUNNER=viewer
# Required when COUNCIL_RUNNER=api. Uncomment and set a loopback URL.
# A path on the base is kept as a prefix. The room POSTs {ANTHROPIC_BASE_URL}/v1/messages
# with the same headers and JSON body as the messages call (x-api-key, anthropic-version, content-type).
# ANTHROPIC_BASE_URL=http://127.0.0.1:8080

# Sent only to KIE_AI_BASE_URL by the portrait script. Never sent to a public host.
KIE_AI_API_KEY=
# Required for portrait upload, job create, record poll, and the credit probe.
# Only loopback is accepted. kie.ai and kieai.redpandaai.co are refused.
# Uncomment and set a loopback URL. A path on the base is kept as a prefix.
# The local server must speak the same requests as the portrait script:
#   POST {KIE_AI_BASE_URL}/api/file-base64-upload
#   POST {KIE_AI_BASE_URL}/api/v1/jobs/createTask
#   GET  {KIE_AI_BASE_URL}/api/v1/jobs/recordInfo?taskId=
#   GET  {KIE_AI_BASE_URL}/api/v1/chat/credit
# Photo downloads and result-image downloads must be loopback URLs too.
# Redirects are checked again and a non-local Location is refused.
# KIE_AI_BASE_URL=http://127.0.0.1:8081
